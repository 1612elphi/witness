{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Beam is consumed from vendored source; mirror its reference tsconfig. */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "styled-system/*": ["./styled-system/*"],
      "@sunbeam/beam-ui": ["./vendor/beam-ui/src/index.ts"],
      "@sunbeam/beam-ui/*": ["./vendor/beam-ui/src/*"]
    }
  },
  "include": ["src", "styled-system", "vendor/beam-ui/src"]
}
